<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="01-rbac-permission" author="bbcms">
        <createTable tableName="bbcms_permission">
            <column name="code" type="VARCHAR(80)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="01-rbac-role" author="bbcms">
        <createTable tableName="bbcms_role">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="created_by" type="UUID"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="UUID"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="01-rbac-role-permission" author="bbcms">
        <createTable tableName="bbcms_role_permission">
            <column name="role_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_role_perm_role"
                             references="bbcms_role(id)"
                             deleteCascade="true"/>
            </column>
            <column name="permission_code" type="VARCHAR(80)">
                <constraints nullable="false"
                             foreignKeyName="fk_role_perm_perm"
                             references="bbcms_permission(code)"
                             deleteCascade="true"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="bbcms_role_permission"
                       columnNames="role_id, permission_code"
                       constraintName="pk_role_permission"/>
    </changeSet>

    <changeSet id="01-rbac-user-role-assignment" author="bbcms">
        <createTable tableName="bbcms_user_role_assignment">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_account_id" type="UUID"><constraints nullable="false"/></column>
            <column name="role_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_ura_role"
                             references="bbcms_role(id)"/>
            </column>
            <column name="scope_bible_club_id" type="UUID"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="UUID"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="bbcms_user_role_assignment" indexName="ix_ura_user">
            <column name="user_account_id"/>
        </createIndex>
        <createIndex tableName="bbcms_user_role_assignment" indexName="ix_ura_scope">
            <column name="scope_bible_club_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="01-settings" author="bbcms">
        <createTable tableName="bbcms_setting">
            <column name="key" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="value" type="TEXT"><constraints nullable="false"/></column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="updated_by" type="UUID"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
