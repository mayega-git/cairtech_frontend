# BBCMS — fichier d'environnement (template)
# Copier en `.env` et adapter les valeurs locales (ne PAS committer .env).

# ---- Super-admin auto-créé au démarrage ----
BBCMS_SUPER_ADMIN_ENABLED=true
BBCMS_SUPER_ADMIN_EMAIL=admin@chf.org
BBCMS_SUPER_ADMIN_PASSWORD=ChangeMeNow_2025!
BBCMS_SUPER_ADMIN_FIRST_NAMES=Super
BBCMS_SUPER_ADMIN_NEXT_NAMES=Admin
# Passer à true le temps d'un redémarrage pour ré-appliquer le mot de passe
# ci-dessus à un compte super-admin existant. Remettre à false ensuite.
BBCMS_SUPER_ADMIN_FORCE_PASSWORD_RESET=false

# ---- Dev data seeding (idempotent — ne se déclenche que si la BD est vide) ----
BBCMS_DEV_DATA_ENABLED=true
BBCMS_DEV_DATA_PASSWORD=Demo_2025!

# ---- Base de données ----
BBCMS_R2DBC_URL=r2dbc:postgresql://localhost:5432/bbcms
BBCMS_JDBC_URL=jdbc:postgresql://localhost:5432/bbcms
BBCMS_DB_USER=bbcms
BBCMS_DB_PASSWORD=bbcms

# ---- JWT ----
# Doit faire >= 32 octets (256 bits)
BBCMS_JWT_SECRET=change-me-in-production-this-must-be-at-least-256-bits-long-secret

# ---- MinIO ----
BBCMS_MINIO_ENDPOINT=http://localhost:9000
BBCMS_MINIO_ACCESS_KEY=minioadmin
BBCMS_MINIO_SECRET_KEY=minioadmin
BBCMS_MINIO_BUCKET=bbcms-media

# ---- SMTP ----
BBCMS_SMTP_HOST=localhost
BBCMS_SMTP_PORT=1025
BBCMS_FROM_EMAIL=no-reply@chf.org

# ---- Frontend public URL (utilisée dans les emails d'activation / reset) ----
# Web dev :   http://localhost:3000
# Android emu: http://10.0.2.2:3000
BBCMS_FRONTEND_BASE_URL=http://localhost:3000

# ---- Application ----
BBCMS_PORT=8080
