<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="09-disciple-link" author="bbcms">
        <createTable tableName="bbcms_disciple_link">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="disciple_maker_member_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dl_maker"
                             references="bbcms_member(id)"/>
            </column>
            <column name="disciple_member_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dl_disciple"
                             references="bbcms_member(id)"/>
            </column>
            <column name="date_assigned" type="DATE"><constraints nullable="false"/></column>
            <column name="date_ended" type="DATE"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="bbcms_disciple_link" indexName="ix_dl_maker">
            <column name="disciple_maker_member_id"/>
        </createIndex>
        <createIndex tableName="bbcms_disciple_link" indexName="ix_dl_disciple">
            <column name="disciple_member_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="09-discipleship-record" author="bbcms">
        <createTable tableName="bbcms_discipleship_record">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="disciple_maker_member_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dr_maker"
                             references="bbcms_member(id)"/>
            </column>
            <column name="meeting_id" type="UUID">
                <constraints foreignKeyName="fk_dr_meeting"
                             references="bbcms_meeting(id)"/>
            </column>
            <column name="date_occurred" type="DATE"><constraints nullable="false"/></column>
            <column name="start_time" type="TIME"/>
            <column name="end_time" type="TIME"/>
            <column name="theme" type="VARCHAR(200)"/>
            <column name="location" type="VARCHAR(200)"/>
            <column name="meeting_description" type="TEXT"/>
            <column name="disciples_state_text" type="TEXT"/>
            <column name="spiritual_investment_text" type="TEXT"/>
            <column name="created_by" type="UUID"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="UUID"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="09-discipleship-present" author="bbcms">
        <createTable tableName="bbcms_discipleship_present">
            <column name="record_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dp_record"
                             references="bbcms_discipleship_record(id)"
                             deleteCascade="true"/>
            </column>
            <column name="disciple_member_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dp_member"
                             references="bbcms_member(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="bbcms_discipleship_present"
                       columnNames="record_id, disciple_member_id"
                       constraintName="pk_dp"/>
    </changeSet>

</databaseChangeLog>
