<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="06-event" author="bbcms">
        <createTable tableName="bbcms_event">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <!-- NATIONAL_CONGRESS / NATIONAL_SUMMIT / CONFERENCE -->
            <column name="type" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="planned_start_dt" type="TIMESTAMPTZ"><constraints nullable="false"/></column>
            <column name="planned_end_dt" type="TIMESTAMPTZ"/>
            <column name="started_at" type="TIMESTAMPTZ"/>
            <column name="ended_at" type="TIMESTAMPTZ"/>
            <column name="duration_minutes" type="INT"/>
            <column name="location" type="VARCHAR(200)"/>
            <column name="max_pictures" type="INT" defaultValueNumeric="50"/>
            <!-- PLANNED / REGISTRATION_OPEN / ONGOING / ENDED / CANCELLED -->
            <column name="status" type="VARCHAR(20)" defaultValue="PLANNED">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="UUID"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="UUID"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="bbcms_event" indexName="ix_event_status"><column name="status"/></createIndex>
        <createIndex tableName="bbcms_event" indexName="ix_event_planned_start"><column name="planned_start_dt"/></createIndex>
    </changeSet>

    <changeSet id="06-event-participation" author="bbcms">
        <createTable tableName="bbcms_event_participation">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_ep_event"
                             references="bbcms_event(id)"
                             deleteCascade="true"/>
            </column>
            <column name="member_id" type="UUID"/>
            <column name="visitor_id" type="UUID"/>
            <column name="registered_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="present" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="present_at" type="TIMESTAMPTZ"/>
        </createTable>
        <sql>
            ALTER TABLE bbcms_event_participation
            ADD CONSTRAINT ck_ep_member_or_visitor
            CHECK ((member_id IS NOT NULL) != (visitor_id IS NOT NULL));
        </sql>
        <addUniqueConstraint tableName="bbcms_event_participation"
                             columnNames="event_id, member_id"
                             constraintName="uk_ep_event_member"/>
        <createIndex tableName="bbcms_event_participation" indexName="ix_ep_event"><column name="event_id"/></createIndex>
        <createIndex tableName="bbcms_event_participation" indexName="ix_ep_member"><column name="member_id"/></createIndex>
    </changeSet>

    <changeSet id="06-event-picture" author="bbcms">
        <createTable tableName="bbcms_event_picture">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_epic_event"
                             references="bbcms_event(id)"
                             deleteCascade="true"/>
            </column>
            <column name="file_id" type="UUID"><constraints nullable="false"/></column>
            <column name="caption" type="VARCHAR(255)"/>
            <column name="taken_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
